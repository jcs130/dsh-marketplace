{
  "id": "dsh-minecraft-agent",
  "name": "Minecraft Agent",
  "version": "0.3.0-rc.15",
  "description": "Minecraft Java Agent for DSH with in-page setup, shared game view, native reasoning and tool receipts, game memory and optional isolated experiments. Verified with stock DSH 0.2.1-rc.2 and rc.3; installation starts no game or model.",
  "descriptionZh": "DSH 我的世界 Agent：页面内配置进服，游戏与原生推理、回答、工具回执并排显示，保留游戏记忆和可选独立实验室。官方 DSH0.2.1-rc.2/rc.3 已验证；安装不启动游戏或模型。",
  "author": {
    "name": "jcs130",
    "url": "https://github.com/jcs130"
  },
  "license": "MIT",
  "category": "integration",
  "tags": [
    "minecraft",
    "我的世界",
    "agent",
    "mineflayer",
    "desktop",
    "harness2",
    "experiments",
    "visualization",
    "game-memory",
    "quick-setup",
    "reasoning",
    "qiandengji"
  ],
  "compatibility": {
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "npm",
    "spec": "@jcs130/dsh-minecraft-agent",
    "command": "dsh plugin --profile {profile} add @jcs130/dsh-minecraft-agent@0.3.0-rc.15 --registry=https://registry.npmjs.org"
  },
  "verified": false,
  "repository": "https://github.com/jcs130/dsh-minecraft-agent",
  "docs": "https://github.com/jcs130/dsh-minecraft-agent/blob/main/docs/quick-start.md",
  "deprecated": false
}
