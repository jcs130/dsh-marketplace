{
  "id": "dsh-minecraft-agent",
  "name": "Minecraft Agent",
  "version": "0.3.0-rc.19",
  "description": "Minecraft Java Agent for DSH with editable personas, local viewer skins, a shared server notebook, offline retrieval, native reasoning/tools and optional isolated experiments. Mineral queries default off. Installation starts no game or model.",
  "descriptionZh": "DSH 我的世界 Agent：配置角色与本地网页皮肤，用户和 Agent 共用服务器笔记，内置离线词元向量和关键词检索；游戏与原生推理、工具回执并排显示，保留独立实验室。矿透默认关闭；安装不启动游戏或模型。",
  "author": {
    "name": "jcs130",
    "url": "https://github.com/jcs130"
  },
  "license": "MIT",
  "category": "integration",
  "tags": [
    "minecraft",
    "我的世界",
    "agent",
    "mineflayer",
    "desktop",
    "harness2",
    "experiments",
    "visualization",
    "game-memory",
    "quick-setup",
    "reasoning",
    "qiandengji",
    "authme",
    "notebook",
    "persona",
    "local-skin"
  ],
  "compatibility": {
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "npm",
    "spec": "@jcs130/dsh-minecraft-agent",
    "command": "dsh plugin --profile {profile} add @jcs130/dsh-minecraft-agent@0.3.0-rc.19 --registry=https://registry.npmjs.org"
  },
  "verified": false,
  "repository": "https://github.com/jcs130/dsh-minecraft-agent",
  "docs": "https://github.com/jcs130/dsh-minecraft-agent/blob/main/docs/quick-start.md",
  "deprecated": false
}
