{
  "id": "dsh-minecraft-agent",
  "name": "Minecraft Agent",
  "version": "0.3.0-rc.21",
  "description": "Minecraft Java Agent for DSH with local MineDojo knowledge indexes, survival guides, editable personas, configurable viewer, server notebooks and native reasoning/tools. Explicit local data preparation; installation starts no game or model.",
  "descriptionZh": "DSH 我的世界 Agent：MineDojo 本地知识库与生存攻略，角色、画面和服务器笔记可配置，游戏旁展示原生推理和工具回执；支持配置目标恢复与独立新会话。资料显式准备，矿透默认关闭；安装不启动游戏或模型。",
  "author": {
    "name": "jcs130",
    "url": "https://github.com/jcs130"
  },
  "license": "MIT",
  "category": "integration",
  "tags": [
    "minecraft",
    "我的世界",
    "agent",
    "mineflayer",
    "desktop",
    "harness2",
    "experiments",
    "visualization",
    "game-memory",
    "quick-setup",
    "reasoning",
    "qiandengji",
    "authme",
    "notebook",
    "persona",
    "local-skin",
    "minedojo",
    "knowledge-base",
    "survival"
  ],
  "compatibility": {
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "npm",
    "spec": "@jcs130/dsh-minecraft-agent",
    "command": "dsh plugin --profile {profile} add @jcs130/dsh-minecraft-agent@0.3.0-rc.21 --registry=https://registry.npmjs.org"
  },
  "verified": false,
  "repository": "https://github.com/jcs130/dsh-minecraft-agent",
  "docs": "https://github.com/jcs130/dsh-minecraft-agent/blob/main/docs/quick-start.md",
  "deprecated": false
}
